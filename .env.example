# Umgebungsvariablen für den Poker-Server.
# deploy.sh fragt jeden Wert einzeln ab und schreibt daraus eine .env (Rechte 600).
# Diese Datei enthält bewusst keine echten Werte.

# Discord-Webhook-URL für den P/L-Export einer Session in einen Discord-Channel.
# Leer lassen, wenn kein Export gewünscht ist.
DISCORD_WEBHOOK=

# Poker-Tracker (Heimspiel-Abrechnung): Adresse des Trackers, z. B. https://tracker.deine-domain.de
# Leer lassen, wenn keine Übertragung an den Tracker gewünscht ist.
TRACKER_URL=
# Gleiches geheimes Token wie IMPORT_TOKEN beim Tracker (z. B. mit "openssl rand -hex 32" erzeugen).
TRACKER_TOKEN=
